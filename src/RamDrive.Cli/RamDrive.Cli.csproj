<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>RamDrive</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <RetainVMGarbageCollection>true</RetainVMGarbageCollection>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Speed</OptimizationPreference>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!-- Release-only AOT flags: smaller binary across arches -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <StackTraceSupport>false</StackTraceSupport>
    </PropertyGroup>

    <!-- x64-only: widen SIMD baseline to x86-64-v3 (avx2+bmi1+bmi2+fma+lzcnt+movbe) plus AES-NI.
         ARM64 takes the AOT default (baseline ARMv8), which is fine for compatibility. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(RuntimeIdentifier)' == 'win-x64'">
        <IlcInstructionSet>x86-64-v3,aes</IlcInstructionSet>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="WinFsp.Native"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RamDrive.Core\RamDrive.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.jsonc">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
